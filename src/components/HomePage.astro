---
/**
 * Home: the credential cost comparator on the first screen, then the reference page (RECETTE §5, §21): the six
 * credentials side by side (floor and expected exam fees), why pass rates reorder them, the dated fee and rule
 * changes of 2025 to 2027, three candidates worked through, what is left out, sources and the list of pages.
 * Every figure comes from the engine or the parameter file.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Tool from './Tool.astro';
import Sources from './Sources.astro';
import Clamp from './Clamp.astro';
import { route } from '../i18n/routes';
import { PAGES } from '../lib/guides';
import { groupLabel, GROUPS_ORDER } from '../i18n/nav';
import { helpers } from '../lib/helpers';
import { LAST_UPDATED, AUTHOR_NAME } from '../data/site-config';
import { displayDate, triesInWords as tw } from '../lib/format';
import { faqSchema, webApplicationSchema, websiteSchema, organizationSchema } from '../lib/seo';
const lang = 'en';
const h = helpers(true);
const { P, E, m, m2, pc } = h;

// The comparator's default case: CPA with one section retaken, no prep; the two-question tool comes first.
// One CPA headline on every page: the four sections passed the first time. No AICPA pass rate is used since
// 2026-11-08 (its terms limit use to personal, non-commercial purposes); retakes are typed by the reader.
const cpa = E.cpaTotal({ state: null, retakes: 0, prep: 0 });
const cpaFirst = cpa.exams;
const cfaE = E.cfaTotal({ window: 'early', rateBasis: 'tenYear', prepPerLevel: 0, duesPerYear: 0, duesYears: 0 });
const cfaS = E.cfaTotal({ window: 'standard', rateBasis: 'tenYear', prepPerLevel: 0, duesPerYear: 0, duesYears: 0 });
const cfp = E.cfpTotal({ window: 'early', education: 0, prep: 0, years: 0, basis: 'latest' });
const fl = E.floors();
const ea = E.eaTotal({ sittings: 3, prep: 0, years: 1 });
const cia = E.ciaTotal({ member: false, year: '2026', extraSittings: 0, prep: 0 });
const ciaM = E.ciaTotal({ member: true, year: '2026', extraSittings: 0, prep: 0 });
const frm = E.frmTotal({ window: 'early', extraSittings: 0, prep: 0 });

const cfaSit = cfaE.rows.reduce((a, r) => a + r.sittings, 0);
// Second figure when no pass rate is counted: what one retake adds, said as a risk (4th round: “$1,074 next to $7,800
// reads as seven times cheaper”), never a bare “first-try price only”.
// Final round (2026-11-09): every row gets an amount with retakes, so the column compares like with like; where no pass
// rate is counted, the amount is one retake, then two, named as such.
const withRetakes = (first: number, add: number) => `${m(first + add)} with one retake<br><span class="text-xs text-navy-600">${m(first + 2 * add)} with two</span>`;
const cpaOnly = withRetakes(cpaFirst, P.cpa.sectionFee);
const ciaPart = (fl.cia[1] - cia.application) / 3;
const firstOnly = (first: number, add: number) => withRetakes(first, add);
// EA, CIA and FRM: no pass rate, so the second figure says what one retake adds instead of a blank
// (2nd round: “the comparison stops halfway”).
// Three columns only (4th round: “What / you / need / first” broken word by word on a phone); what each credential
// needs is said once, in the beginner section above, and the pass rates used are named in the caption.
const compare = [
  { id: 'cpa-exam-cost', name: 'CPA, accountant (four sections)', body: 'NASBA (the national association of state boards) and your state board', floor: m(cpaFirst), exp: cpaOnly },
  { id: 'cfa-exam-cost', name: 'CFA® Program, investment (three levels)', body: 'CFA Institute', floor: m(fl.cfa[0]), exp: `${m(cfaE.exams)}<br><span class="text-xs text-navy-600">usual retakes: ${tw(cfaSit)} in total, against 3</span>` },
  { id: 'cfp-certification-cost', name: 'CFP® certification, financial planner', body: 'CFP Board', floor: m(fl.cfp[0]), exp: `${m(cfp.exams + P.cfp.application)}<br><span class="text-xs text-navy-600">usual retakes: ${tw(cfp.sittings)}, against 1</span>` },
  { id: 'enrolled-agent-exam', name: 'Enrolled agent, tax (three-part IRS exam)', body: 'the IRS and its test provider', floor: m(fl.ea[0]), exp: firstOnly(fl.ea[0], P.ea.perPart) },
  { id: 'cia-exam', name: 'CIA, internal auditor (three parts)', body: 'The IIA (Institute of Internal Auditors)', floor: `${m(fl.cia[1])} (${m(fl.cia[0])} for members of The IIA)`, exp: firstOnly(fl.cia[1], ciaPart) },
  { id: 'frm-exam', name: 'FRM®, risk manager (two parts)', body: 'GARP (Global Association of Risk Professionals)', floor: m(fl.frm[0]), exp: firstOnly(fl.frm[0], P.frm.early) },
];
const rows = compare.map((c) => [`<a href="${route(c.id, lang)}">${c.name}</a><br><span class="text-xs text-navy-600">Paid to ${c.body}</span>`, c.floor, c.exp]);
// Words a beginner meets on every page, said once (4th round: “try, attempt, sitting, window, session: five things?”).
const words = [
  ['Try', 'one sitting of one exam. A retake is a try after a fail, and it is paid again.'],
  ['Pass rate', 'the share of candidates who passed in a period. When about half pass, an average candidate needs two tries.'],
  ['Window', 'the weeks in which an exam can be taken. You register before it starts: early, at the lower price, or by the later standard deadline.'],
  ['Semester hours', 'college credit hours on your transcript. A bachelor’s degree is usually about 120; a fifth year brings it to about 150.'],
  ['Dues', 'yearly fees paid to keep a title once you have it.'],
];
// What each credential is, in one line (naive test of 2026-11-08: “I see prices for letters I do not know”).
// Every fact here is stated, with its source, on the credential's own page.
const creds = [
  { id: 'cpa-exam-cost', name: 'CPA, Certified Public Accountant', what: 'the state license for accounting and audit work.', need: 'Most states ask for about five years of college (150 credit hours); more and more accept a bachelor’s degree (120 hours) with more work experience.' },
  { id: 'enrolled-agent-exam', name: 'EA, Enrolled Agent', what: 'a tax practitioner authorized by the IRS to represent taxpayers before it.', need: 'No college degree: a three-part IRS exam, then enrollment and a check that your own taxes are in order.' },
  { id: 'cfp-certification-cost', name: 'CFP® certification (CERTIFIED FINANCIAL PLANNER®)', what: 'for advice on personal financial planning.', need: `A bachelor’s degree, courses approved by CFP Board, one exam and ${h.num(P.cfp.experience.standard)} hours of work experience (${h.num(P.cfp.experience.apprenticeship)} as an apprentice).` },
  { id: 'cfa-exam-cost', name: 'CFA® Program (Chartered Financial Analyst®)', what: 'three exams set by CFA Institute, for investment professionals.', need: 'The three levels are taken one after the other, usually over several years.' },
  { id: 'cia-exam', name: 'CIA, Certified Internal Auditor', what: 'the designation for internal auditors, granted by The Institute of Internal Auditors (The IIA).', need: 'An application, then three exam parts.' },
  { id: 'frm-exam', name: 'FRM®, Financial Risk Manager', what: 'a risk management designation from GARP, the Global Association of Risk Professionals.', need: 'Two exams, Part I and Part II, and an experience requirement.' },
];

// Six questions: the floor check-trame sets for a pillar page (§7); each answer leads with the figure the table shows.
const faqs = [
  { q: 'Which finance certification is the cheapest to earn?', a: `At the first try, in official exam fees: the CPA (${m(cpaFirst)}), then the CFP® exam with its application (${m(fl.cfp[0])}) and the enrolled agent exam with enrollment (${m(fl.ea[0])}). The CIA costs ${m(cia.total)}, or ${m(ciaM.total)} once you pay to join The IIA, the internal auditors’ association, whose dues are not counted. Retakes change the order: the CFA® rises to about ${m(cfaE.exams)}.` },
  { q: 'Which finance certification costs the most?', a: `The CFA® Program: about ${m(cfaE.exams)} in exam fees once the usual retakes are counted, with early registration. Only a candidate who passes all three exams at the first try pays less, ${m(fl.cfa[0])}. Review courses for three exams and the yearly fees after the title come on top.` },
  { q: 'How is the expected number of retakes worked out?', a: 'From the pass rates CFA Institute and CFP Board publish. When about half of candidates pass, an average candidate sits the exam twice; when two in three pass, about one and a half times. For the CPA, enrolled agent, CIA and FRM® you type the retakes you expect. Your own odds may be better or worse.' },
  { q: 'How much should I count for review courses?', a: 'This site sells none and has checked no course price, so every calculator starts at zero. Not sure? Review courses, books and practice exams often cost as much as all the exam fees, or more: each calculator offers that rough guess as a choice, until you have a real price.' },
  { q: 'Is this site connected to CFA Institute, CFP Board or the AICPA?', a: 'No. It is an independent site, not affiliated with CFA Institute, CFP Board, the AICPA (the accountants’ institute that writes the CPA exam), the IRS, The IIA, GARP or any state board. CFA®, CFP® and the other marks belong to their owners and are used only to name the credentials.' },
  { q: 'Do I need to give an e-mail to use the calculators?', a: 'No. There is no form, no account and no newsletter. The calculators run in your browser and nothing you type is sent anywhere; the address bar changes only if you choose to copy a link to your own figures. Nothing is stored after you close the page.' },
];
// Citable block (§21): one paragraph, two sentences in view, the rest one tap away.
const resume = `Six US finance credentials are compared here on the fees their bodies charge for the exams: the CPA for accountants (${m(cpaFirst)} for four sections passed the first time), the CFP® for financial planners (${m(fl.cfp[0])} with the application), the enrolled agent for tax work (${m(fl.ea[0])} with enrollment, and no college degree required), the CIA for internal auditors (${m(cia.total)} for a non-member), the FRM® for risk managers (${m(fl.frm[0])}) and the CFA® Program for investment analysts (${m(fl.cfa[0])}). Those are prices for a candidate who never fails. Failed exams are paid again, and pass rates make retakes likely: counted at the rates CFA Institute and CFP Board publish, the CFA® comes to about ${m(cfaE.exams)} and the CFP® to about ${m(cfp.exams + P.cfp.application)}. Review courses, school programs and yearly dues come on top; every calculator lets you type your own.`;
const jsonLd = [webApplicationSchema({ name: 'Finance certification cost comparator', description: 'Total cost of the CPA, CFA®, CFP®, enrolled agent, CIA and FRM® credentials: official fees, expected retakes from published pass rates or typed by you, prep and dues.', path: route('home', lang), lang }), websiteSchema(lang), organizationSchema(lang), faqSchema(faqs, lang)];
// Profile doors (rule 2 of 2026-11-10): the question of each reader, answered by a figure and a link.
const doors = [
  { who: 'No degree: enrolled agent', fig: m(fl.ea[0]), href: route('enrolled-agent-exam', lang) },
  { who: 'Accounting: CPA', fig: m(cpaFirst), href: route('cpa-exam-cost', lang) },
  { who: 'Investments: CFA®', fig: `about ${m(cfaE.exams)}`, href: route('cfa-exam-cost', lang) },
  { who: 'Family money: CFP®', fig: `about ${m(cfp.exams + P.cfp.application)}`, href: route('cfp-certification-cost', lang) },
];
const groups = GROUPS_ORDER.map((g) => ({ g, pages: PAGES.filter((p) => p.group === g) })).filter((x) => x.pages.length);
---
<PageLayout title="Finance Certification Cost 2026: CPA, CFA®, CFP® and More" description="Finance certification cost in 2026: CPA, CFA®, CFP®, EA, CIA and FRM® official fees, the retakes published pass rates make likely, your prep and dues, compared." lang={lang} jsonLd={jsonLd} faqs={faqs.map((f, i) => ({ ...f, open: i < 2 }))}>
  <header class="mb-2">
    <h1 class="text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl">Finance certification cost: the exam fees you will really pay, retakes included</h1>
    <p class="mt-2 text-base text-navy-700 sm:text-lg">Finance certification cost, in official exam fees for six US credentials, runs from {m(cpaFirst)} for the CPA (licensed accountant) to {m(fl.cfa[0])} for the three CFA® exams (investment analyst) if you pass every exam the first time. With the usual retakes, the CFA® comes to about {m(cfaE.exams)}. Nothing you type is sent.</p>
    <p class="mt-1 text-xs text-navy-600">Independent site: not run by, or affiliated with, any body that sets these exams or charges these fees.</p>
  </header>
  {/* Rule 2 of 2026-11-10: one door per profile, before the form, each with its figure. */}
  <nav aria-label="Start from your situation" class="mb-2">
    <ul class="flex flex-wrap items-center gap-1.5 text-sm">
      <li class="font-semibold text-navy-900 max-sm:w-full">Start from your situation:</li>
      {doors.map((d) => <li class="max-sm:w-full"><a href={d.href} class="flex min-h-8 items-center justify-between gap-2 rounded-md border border-accent-600 bg-white px-2.5 py-0.5 text-navy-900 no-underline hover:bg-accent-50"><span>{d.who}</span><span class="tabular-nums whitespace-nowrap font-bold">{d.fig} →</span></a></li>)}
    </ul>
  </nav>
  <div data-outil class="mb-4" id="start-title"><Tool tool={{ kind: 'mini:start', props: { title: 'Which one fits you? Two questions' } }} primary={true} /></div>
  <Clamp text={resume} id="clamp-home" lang={lang} class="mb-3" />
  <p class="mb-8 text-sm text-navy-600">Fees and pass rates checked on the official pages on {h.read} · {AUTHOR_NAME} · <a href={route('method', lang)} class="underline hover:text-navy-900">How the totals are built</a> · <a href={route('about', lang)} class="underline hover:text-navy-900">Who publishes this site</a></p>

  <section class="not-prose my-10" aria-labelledby="compare-title">
    <h2 id="compare-title" class="text-2xl font-bold text-navy-900">Six finance certifications: first-try price and price with retakes</h2>
    <p class="mt-2 text-navy-800"><strong>First try: you pass every exam the first time. With retakes: for the CFA® and CFP®, the usual retakes from the pass rates their bodies publish; for the four others, one retake, then two.</strong> This site counts no pass rate for them: the AICPA (the accountants’ institute) does not allow its CPA rates to be copied, and the IRS, The IIA and GARP publish none we could read. Neither figure includes review courses or yearly fees.</p>
    <Fragment set:html={h.table(['Credential', 'First try', 'With retakes'], rows, `Official fee pages and pass-rate files. Early registration where there is a choice. CFA®: pass rates of 2017 to 2026. CFP®: pass rates of ${h.ml(E.cfpLatest().w)}; the ${m(P.cfp.application)} application is included. Enrolled agent: enrollment and one year of the tax preparer ID included. CPA: without state board fees, which the CPA page adds for five states.`, ['l', 'r', 'r'])} />
    <p class="mt-3 text-navy-800">Each name in the table opens that credential’s own calculator, where you can add your retakes, your review course and your state.</p>
  </section>

  <section class="not-prose my-10" aria-labelledby="six-title">
    <h2 id="six-title" class="text-2xl font-bold text-navy-900">What each of the six is, in one line</h2>
    <dl class="mt-4 space-y-4">
      {creds.map((c) => (
        <div class="border-l-4 border-accent-600 pl-4">
          <dt class="font-semibold text-navy-900"><a href={route(c.id, lang)} class="text-accent-700 underline underline-offset-2">{c.name}</a></dt>
          <dd class="text-navy-800">{c.what} <strong>What you need first:</strong> {c.need}</dd>
        </div>
      ))}
    </dl>
    <h3 class="mt-6 text-lg font-semibold text-navy-900">Five words you will see on every page</h3>
    <dl class="mt-2 space-y-2 text-navy-800">{words.map(([w, d]) => <div><dt class="inline font-semibold">{w}:</dt> <dd class="inline">{d}</dd></div>)}</dl>
  </section>

  <div class="prose prose-slate max-w-none">
    <h2>Why the price list is not the budget</h2>
    <p><strong>Fewer than half of CFA® candidates pass a level.</strong> Its three exams cost {m(fl.cfa[0])} if each is passed at the first try, but an average candidate sits {tw(cfaSit).replace(/ tries$/, '')} exams in all. Counted at CFA Institute’s own pass rates, the fees come to about {m(cfaE.exams)}: that figure, not the price list, is what a budget should start from.</p>
    <p><strong>Review courses are the line only you can fill in.</strong> They often cost as much as all the exam fees, or more. This site sells none and has checked no price, so every calculator starts without them. Not sure? Each calculator offers a rough guess: as much as the exam fees.</p>
    <p><strong>Not counted anywhere:</strong> yearly dues, the school program the CFP® asks for, fees a board does not publish, travel and time off work. This site measures cost, not the salary a credential may bring.</p>
  </div>

  <section class="mt-12 mb-10" aria-labelledby="guides-title">
    <h2 id="guides-title" class="text-2xl font-bold text-navy-900">All pages, by credential</h2>
    <div class="mt-4 grid gap-6 md:grid-cols-2">
      {groups.map(({ g, pages }) => (
        <div class="border-t-4 border-accent-600 pt-3">
          <h3 class="text-lg font-semibold text-navy-900">{groupLabel(g)}</h3>
          <ul class="mt-2 space-y-2">{pages.map((p) => <li><a href={route(p.id, lang)} class="font-medium text-accent-700 underline-offset-2 hover:underline">{p.nav}</a></li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <div class="prose prose-slate max-w-none">
    <Sources lang={lang} intro="Each exam fee, pass rate and board rule on this page comes from the official pages below (the credential bodies, the IRS and five state boards), read on" />
  </div>
</PageLayout>
